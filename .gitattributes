# Keep repository text files stable across Windows development machines.
* text=auto eol=lf

# Windows command files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary engineering assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.zip binary
*.rar binary
*.7z binary
